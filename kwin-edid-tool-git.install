post_install() {
	systemctl enable sunshine-edid-helper.service sunshine-edid-seed.service > /dev/null 2>&1 || true
	echo "==> sunshine-edid-helper.service and sunshine-edid-seed.service enabled for next boot."
	echo "==> Start the helper now with: sudo systemctl start sunshine-edid-helper"
	echo "==> Every requested resolution is saved under /var/lib/sunshine-edid-helper and re-applied"
	echo "    at boot, before the display manager starts, so it is available from the first connection."
}

post_upgrade() {
	post_install
}
